# 알바지킴이 설정 예시. 이 파일을 .env로 복사해 값을 채운다 (.env는 커밋하지 않는다). 고친 뒤에는 서버를 다시 켠다.
# 키마다 자세한 설명: docs/실행가이드.md 4절

# 로그인 쿠키에 서명하는 비밀키. 외부에 여는 서버에서는 꼭 바꾼다
# 만들기: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# AI 모델 (대회 GPU 서버의 vLLM, OpenAI 호환 API)
# true로 바꾸면 조항 판단과 사진 읽기(계약서, 급여명세서)를 AI가 한다. false면 가짜 AI(LLM_FAKE=auto일 때)가 답하거나 'AI 응답 대기 중'으로 둔다.
LLM_ENABLED=false
LLM_BASE_URL=http://localhost:8000/v1
# vLLM에 띄운 모델 이름 (vllm serve 할 때 쓴 이름, 또는 GET /v1/models 결과의 id)
LLM_MODEL=
# 사진 읽기용 비전 모델 (비우면 LLM_MODEL을 쓴다. LLM_MODEL이 비전 모델이면 비워 둔다)
LLM_VISION_MODEL=
# vllm serve --api-key를 쓴 경우만
LLM_API_KEY=
LLM_TIMEOUT=120
# AI 답 하나의 최대 길이(토큰). 모델이 끝없이 써도 요청이 오래 걸리지 않게 (0이면 제한 없음)
LLM_MAX_TOKENS=4096
# 모델마다 필요한 요청 옵션 (JSON). 예: 생각 모드 끄기 {"chat_template_kwargs": {"enable_thinking": false}}
LLM_EXTRA_BODY=
# 모델 공식 문서의 권장 생성 설정 (JSON). 비우면 temperature 0. null은 모델 기본값(generation_config.json)
# 예: EXAONE 4.5 {"temperature": 0.6, "top_p": 0.95, "top_k": 20, "presence_penalty": 1.5}
LLM_SAMPLING=
# 에이전트 판단 반복 최대 횟수 (3~50, 기본 30). AI 버튼은 서버가 뒤에서 실행해 오래 걸려도 cloudflared(100초)에 끊기지 않는다
AGENT_MAX_STEPS=30
# 가짜 AI (시험용). AI가 쓰는 글은 모두 '테스트 답변입니다 (...)'
# auto: 실제 모델 설정(LLM_ENABLED=true, LLM_MODEL)이 없으면 가짜 AI로 답한다 (기본)
# true: 늘 가짜 AI / false: 가짜 AI를 쓰지 않음 (모델이 없으면 'AI 응답 대기 중'으로 둔다)
LLM_FAKE=auto
# 가짜 AI가 요청을 받고 답하기까지 기다리는 시간(초). 에이전트는 한 번 실행에 AI를 여러 번 부르므로 점검 한 번이 수십 초 걸릴 수 있다
LLM_FAKE_DELAY=3

# 외부 API (없으면 해당 기능만 건너뜀)
LAW_OC=
# 서버를 켤 때 법제처에서 법령이 바뀌었는지 확인하고, 바뀐 법령을 받아 법 기준표에 저장한 뒤 시작 (기본 true, LAW_OC 필요)
LAW_REFRESH_ON_START=true
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# AI 응답 대기 중인 일을 다시 맡기는 간격(분)과 하루 최대 횟수 (AI가 연결돼 있을 때만)
AI_RETRY_MIN=10
AI_RETRY_PER_DAY=3

# 매일 자동 점검 시각 (한국 시간, 0~23시)
SCHEDULE_HOUR=9
# 출근하고 이 시간(초) 안에 퇴근을 누르면 한 번 더 묻는다 (실수로 두 번 누름 막기)
PUNCH_CONFIRM_SEC=60
# 출근 뒤 이 시간이 지나도록 퇴근 기록이 없으면 알린다
OPEN_RECORD_ALERT_HOURS=16

# 매일 자동 점검은 이 설정과 상관없이 매일 SCHEDULE_HOUR시(기본 9시)에 돌고, 사업장마다 결과를 알림으로 보낸다.
# DEV_TOOLS=true는 그 점검을 9시를 기다리지 않고 지금 바로 실행하는 시연용 주소(/api/dev/daily-check)만 연다. 외부에 여는 서버에서는 false
DEV_TOOLS=false

# 로그인 시도 제한: 같은 이메일 N번, 같은 접속 주소 N번 틀리면 N분 동안 막음
LOGIN_MAX_FAILS=5
LOGIN_IP_MAX_FAILS=20
LOGIN_LOCK_MIN=15

# 처음 쓰는 사람 체험 안내: 새로 가입한 계정에 고른 상황별 미션 3개, 업로드할 때 내 파일 / 예시 자료, 다 하면 설문 (시험 계정에는 뜨지 않음)
FIRST_GUIDE=true
# 설문 주소: 체험을 마치면, 그리고 일하는 곳 선택 창에서 늘 보여 준다 (비우면 설문 안내 없음)
SURVEY_URL=https://forms.gle/ed7572w7YeVWUfWC7
# 데모 모드 (업로드 화면을 바꾼다. 데이터는 그대로): true면 모든 계정에서 업로드(채용공고, 계약서, 명세서, 자료 올리기)를 누르면
# '내 기기에서 고르기'와 데모 사진 30장(테스트자료/, 알바 5곳마다 채용공고, 계약서, 근무표, 명세서, 입금 내역, 사장님 메시지)이
# 함께 나온다. 그 칸에 맞는 사진이 먼저 나온다.
# 일하는 곳 등록 화면에는 '이 예시로 채우기'도 늘 보인다. false면 업로드를 누를 때 바로 기기의 파일 고르기 창이 열린다
# (체험 안내 중인 새 계정만 예시 사진 몇 장이 나온다). 실제 업로드, 사진 읽기 시연용
DEMO_MODE=false

# 시험 데이터 (어느 데이터를 쓸지 정한다): true면 기록, 올린 파일, 상담 자료를 모두 data/test 아래에서 쓴다.
# 평소 데이터(data/app.db)는 건드리지 않는다. false면 data/app.db(직접 가입한 계정과 기록)를 쓴다
# DEMO_MODE와 따로 켜고 끈다 (둘 다 켜면 시험 계정으로 알바 5개 사례를 보면서 데모 사진으로 사진 읽기를 해 볼 수 있다)
# 시험 계정: test@example.com, test2@example.com ~ test5@example.com / 비밀번호 test1234 (서버를 켤 때 없으면 만든다. 처음 상태로: python -m app.demo_db --force)
TEST_DATA=false

# 저장 위치(DB_PATH, UPLOAD_DIR, REPORT_DIR)는 적지 않는다. 적으면 TEST_DATA보다 먼저 적용된다 (docs/실행가이드.md 4절)
